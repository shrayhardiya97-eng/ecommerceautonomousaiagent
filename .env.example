# App Configuration
APP_NAME="Autonomous E-Commerce AI Shopping Agent"
DEBUG=True
DEFAULT_CURRENCY=INR

# Shopify API Integration (Optional: Leave blank to use high-fidelity verified mock)
SHOPIFY_SHOP_URL="mystore.myshopify.com"
SHOPIFY_ACCESS_TOKEN="shpat_xxxxxxxxxxxxxxxxxxxxxxxx"
SHOPIFY_API_VERSION="2024-01"
USE_MOCK_SHOPIFY=True

# LLM Providers (Optional: Seamless offline hybrid RAG built-in)
LLM_PROVIDER=auto
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Business & Tax Rules
TAX_RATE=0.18
FREE_SHIPPING_THRESHOLD=999.0
DEFAULT_SHIPPING_FEE=99.0
